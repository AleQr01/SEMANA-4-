class Producto:
    def __init__(self, nombre, precio, stock, talla=None, color=None, marca=None, descripcion=None):
        self.nombre = nombre
        self.precio = precio
        self.stock = stock
        self.talla = talla
        self.color = color
        self.marca = marca
        self.descripcion = descripcion

class Cliente:
    def __init__(self, nombre, apellido, email):
        self.nombre = nombre
        self.apellido = apellido
        self.email = email
        self.carrito = Carrito()

class Carrito:
    def __init__(self):
        self.productos = []

    def agregar_producto(self, producto):
        self.productos.append(producto)

    def eliminar_producto(self, producto):
        self.productos.remove(producto)

    def calcular_total(self):
        total = 0
        for producto in self.productos:
            total += producto.precio
        return total

    def aplicar_descuento(self, porcentaje):
        total = self.calcular_total()
        descuento = total * porcentaje / 100
        return total - descuento

# Ejemplo de uso:
camiseta = Producto("Camiseta", 19.99, 10, "M", "Azul", "Nike", "Camiseta de algodón")
pantalon = Producto("Pantalón", 29.99, 5)

cliente1 = Cliente("Juan", "Pérez", "juan@ejemplo.com")
cliente1.carrito.agregar_producto(camiseta)
cliente1.carrito.agregar_producto(pantalon)

print(f"El cliente {cliente1.nombre} {cliente1.apellido} ha comprado:")
for producto in cliente1.carrito.productos:
    print(f"- {producto.nombre}, talla {producto.talla or 'N/A'}, color {producto.color or 'N/A'}, precio: ${producto.precio}")

print("Total de la compra:", cliente1.carrito.calcular_total())
print("Total con descuento de 10%:", cliente1.carrito.aplicar_descuento(10))
