from datetime import datetime

class Libro:
    def __init__(self, titulo, autor, isbn, fecha_publicacion, genero, paginas):
        self.titulo = titulo
        self.autor = autor
        self.isbn = isbn
        self.fecha_publicacion = fecha_publicacion
        self.genero = genero
        self.paginas = paginas
        self.historial_prestamos = []

    def prestar(self, usuario, fecha_prestamo):
        self.historial_prestamos.append((usuario, fecha_prestamo))
        print(f"Libro '{self.titulo}' prestado a {usuario.nombre} hasta el {fecha_prestamo.strftime('%d/%m/%Y')}")

    def devolver(self, fecha_devolucion):
        if self.historial_prestamos:
            _, fecha_prestamo = self.historial_prestamos[-1]
            print(f"Libro '{self.titulo}' devuelto. Se prestó el {fecha_prestamo.strftime('%d/%m/%Y')} y se devolvió el {fecha_devolucion.strftime('%d/%m/%Y')}")
            self.historial_prestamos.pop()
        else:
            print("El libro no ha sido prestado.")

class Usuario:
    def __init__(self, nombre, id_usuario):
        self.nombre = nombre
        self.id_usuario = id_usuario
        self.libros_prestados = []

    def prestar_libro(self, libro, fecha_prestamo):
        libro.prestar(self, fecha_prestamo)
        self.libros_prestados.append(libro)

